[Unit]
Description=Check and deploy Red Horizon main
Wants=network-online.target
After=network-online.target caddy.service

[Service]
Type=oneshot
User=redhorizon-deploy
Group=redhorizon-deploy
StateDirectory=redhorizon-deploy
CacheDirectory=redhorizon-deploy
Environment=HOME=/var/lib/redhorizon-deploy
Environment=npm_config_cache=/var/cache/redhorizon-deploy
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/cache/redhorizon-deploy/browsers
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/local/lib/redhorizon/deploy-main.sh
TimeoutStartSec=20min
UMask=0022
Nice=10
CPUQuota=100%
# Browser tests run externally. Keep build/Node checks below live services.
CPUWeight=25
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/redhorizon
RestrictSUIDSGID=true

