        "IpProtocol": "tcp",
        "FromPort": 9093,
        "ToPort": 9093,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": [
            "EventsGroup",
            "GroupId"
          ]
        }
      }
    },
    "MetricsEventsIn": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "EventsGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 9400,
        "ToPort": 9400,
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "ObservabilityGroup",
            "GroupId"
          ]
        }
      }
    },
    "MetricsEventsOut": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "ObservabilityGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 9400,
        "ToPort": 9400,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": [
            "EventsGroup",
            "GroupId"
          ]
        }
