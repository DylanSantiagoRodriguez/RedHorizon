          "Fn::GetAtt": [
            "EventsGroup",
            "GroupId"
          ]
        }
      }
    },
    "KafkaEventsOut": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Fn::GetAtt": [
            "EventsGroup",
            "GroupId"
          ]
        },
        "IpProtocol": "tcp",
        "FromPort": 9093,
        "ToPort": 9093,
        "DestinationSecurityGroupId": {
          "Fn::GetAtt": [
            "EventsGroup",
            "GroupId"
          ]
        }
      }
    },
    "ObservabilityRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "PermissionsBoundary": "arn:aws:iam::670036769494:policy/RedHorizonObservabilityRuntimeBoundary",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "ReadBasicMetrics",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "cloudwatch:GetMetricStatistics",
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RedHorizonCluster"
          },
          {
            "Key": "Component",
            "Value": "Observability"
          }
        ]
      }
    },
    "ObservabilityProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "ObservabilityRole"
          }
        ]
      }
    },
    "Observability": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "UbuntuAmi"
        },
        "InstanceType": "c7i-flex.large",
        "KeyName": {
          "Ref": "ObservabilityKeyName"
        },
        "IamInstanceProfile": {
          "Ref": "ObservabilityProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "DisableApiTermination": true,
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Fn::GetAtt": [
                  "ObservabilityGroup",
                  "GroupId"
                ]
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 30,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RedHorizonCluster"
          },
          {
            "Key": "Component",
            "Value": "Observability"
          },
          {
            "Key": "Name",
            "Value": "rh-observability"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\nsystemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service\n"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "EventsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "PermissionsBoundary": "arn:aws:iam::670036769494:policy/RedHorizonObservabilityRuntimeBoundary",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RedHorizonCluster"
          },
          {
            "Key": "Component",
            "Value": "Observability"
          }
        ]
      }
    },
    "EventsProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "EventsRole"
          }
        ]
      }
    },
    "Events": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "UbuntuAmi"
        },
        "InstanceType": "c7i-flex.large",
        "KeyName": {
          "Ref": "EventsKeyName"
        },
        "IamInstanceProfile": {
          "Ref": "EventsProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "DisableApiTermination": true,
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Fn::GetAtt": [
                  "EventsGroup",
                  "GroupId"
                ]
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "VolumeSize": 40,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "RedHorizonCluster"
          },
          {
            "Key": "Component",
            "Value": "Observability"
          },
          {
            "Key": "Name",
            "Value": "rh-events"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\nsystemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service\n"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    }
  },
  "Outputs": {
