        ]
      }
    },
    "Game02PrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Game02",
          "PrivateIp"
        ]
      }
    },
    "Game02PublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Game02",
