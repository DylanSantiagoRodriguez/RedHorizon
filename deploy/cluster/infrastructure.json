        ]
      }
    },
    "GatewaySecurityGroup": {
      "Value": {
        "Fn::GetAtt": [
          "GatewaySecurityGroup",
          "GroupId"
        ]
      }
    },
    "GameSecurityGroup": {
      "Value": {
        "Fn::GetAtt": [
          "GameSecurityGroup",
          "GroupId"
        ]
      }
    },
    "CoordinatorSecurityGroup": {
      "Value": {
