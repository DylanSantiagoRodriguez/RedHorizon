        ]
      }
    },
    "Game03PublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Game03",
          "PublicIp"
        ]
      }
    },
    "CoordinatorPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "Coordinator",
          "PrivateIp"
        ]
      }
    },
    "CoordinatorPublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "Coordinator",
